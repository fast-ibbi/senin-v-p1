# Salin menjadi .env lalu sesuaikan.
# Hanya variabel berawalan EXPO_PUBLIC_ yang dibaca aplikasi.
#
# PENTING: nilai EXPO_PUBLIC_* disisipkan ke dalam bundel JavaScript. Siapa pun
# yang memegang APK bisa membacanya. Jangan pernah menaruh secret di sini.

# Emulator Android memakai 10.0.2.2 (alamat host), bukan localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Untuk ponsel fisik, ganti dengan IP laptop di Wi-Fi yang sama, mis.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
