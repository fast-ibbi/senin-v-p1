{
  "name": "senin-v-p1",
  "version": "1.0.0",
  "private": true,
  "description": "Slide kuliah Pemrograman Mobile (React Native + Expo) \u2014 15 bab, dipublikasikan via GitHub Pages",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && marp -I slides -o dist && npm --prefix demo/web run build && node scripts/build-pages.mjs",
    "serve": "marp -s slides",
    "build:demo": "npm --prefix demo/web run build",
    "update:demo-manifest": "node scripts/update-manifest-demo.mjs",
    "verify:demo-konten": "node scripts/verify-demo-konten.mjs",
    "serve:demo": "npm --prefix demo/web run dev",
    "serve:demo-build": "npm --prefix demo/web run preview",
    "serve:demo-live": "python3 -m http.server 8138 -d demo/bab-05-live/kantin-kampus/dist",
    "export:demo-live": "npm --prefix demo/bab-05-live/kantin-kampus run export:web",
    "serve:demo-pesan": "python3 -m http.server 8139 -d demo/bab-05-pesan-makanan/dist",
    "export:demo-pesan": "npm --prefix demo/bab-05-pesan-makanan run export:web",
    "capture:demo-pesan": "node demo/bab-05-pesan-makanan/scripts/tangkapan-layar.mjs",
    "verify:demo-web": "node scripts/verify-demo-web.mjs",
    "capture:demo-web": "node scripts/screenshot-demo-web.mjs",
    "build:tutorial": "node scripts/build-tutorial-bab05-mahasiswa.mjs",
    "verify:tutorial": "node scripts/build-tutorial-bab05-mahasiswa.mjs --check",
    "smoke:api": "node scripts/smoke-api.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.2.3"
  }
}
